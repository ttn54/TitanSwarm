# ─────────────────────────────────────────────────────────────────────────────
# TitanSwarm — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file. It is .gitignore'd.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose your LLM backend: "gemini" (free tier, default) or "openai"
AI_PROVIDER=gemini

# Gemini API key — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to local SQLite if not set. For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/titanswarm

# ── Scraper Configuration ────────────────────────────────────────────────────
# Target roles and locations for the Sourcing Daemon.
# Use pipe (|) to separate multiple values.
SCRAPER_ROLES=Software Engineer Intern
SCRAPER_LOCATIONS=Vancouver, BC
SCRAPER_INTERVAL_HOURS=12
SCRAPER_RESULTS_WANTED=25

# ── Session Security ────────────────────────────────────────────────────────
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=your_random_64_char_hex_string_here

# ── LinkedIn Credentials (optional — for enhanced scraping) ──────────────────
# LINKEDIN_LOGIN_EMAIL=
# LINKEDIN_LOGIN_PASS=
# LINKEDIN_LI_AT=
# LINKEDIN_JSESSIONID=
